# Credentials are read from environment variables or the OS keyring only.
# Copy to .env and fill in ONLY when you enable the corresponding feature.
# Never commit .env to git.

# Gmail OAuth (Phase 4). Client ID/secret from Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Reactive Resume (Phase 3). Names match what the adapter actually reads.
# API key from your own Reactive Resume instance (Settings -> API tokens).
OFFERBOMBER_RXRESUME_API_KEY=
# Optional. Defaults to https://rxresu.me/api/openapi. Must include /api/openapi.
OFFERBOMBER_RXRESUME_URL=https://rxresu.me/api/openapi

# Optional standalone model API (NOT required for host-model modes).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Notification webhook fallback (optional).
WECOM_WEBHOOK_URL=
